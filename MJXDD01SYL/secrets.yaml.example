# Copy to secrets.yaml. That file stays out of git.
# Replace every value before compiling.

wifi_network: "your-ssid"
wifi_password: "your-wifi-password"
fallback_wifi_password: "fallback-password"
ota_password: "ota-password"

# HomeKit pairing code, three groups: 123-45-678
# Setup id is four uppercase letters. Use a different pair per lamp
# when more than one bridge will be paired.
homekit_setup_code: "123-45-678"
homekit_setup_id: "ABCD"

# 32 hex digits. Only a lamp file that sets receiver.key reads this.
# Leave it out of a build that does not set the relay key.
ble_gateway_key: "00112233445566778899aabbccddeeff"
